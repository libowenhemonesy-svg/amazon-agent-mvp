{
  "productName": "Amazon Agent",
  "version": "0.1.0",
  "identifier": "com.amazonagent.desktop",
  "build": {
    "frontendDist": "../app/static",
    "devUrl": "http://localhost:8010",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Amazon Agent - 运营分析平台",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
